[settings]
idiomatic_version_file_enable_tools = ["ruby"]

[tools]
go = "latest"
bun = "latest"
azure-kubelogin = "0.2.14"
# Track the newest 3.10 patch rather than pinning one. Old patch releases
# stop building against current OpenSSL/toolchains, which is what broke the
# 3.10.12 install; mise resolves this to the highest available 3.10.x.
python = "3.10"
ruby = "3.3.5"
antigravity-cli = "latest"
# herdr is an agent-aware multiplexer -- it owns the terminal itself rather
# than layering on tmux, so it is an alternative to the tmux stack, not an
# addition to it. Resolved through the mise registry (aqua), which has
# macos-aarch64/x86_64 builds alongside the linux ones, so it is shared.
herdr = "latest"
{{- if eq .chezmoi.os "darwin" }}
node = "latest"
{{- else }}
# Linux (Omarchy): these CLIs are provisioned through mise on this host --
# `gh` in particular runs from ~/.local/share/mise/shims, so dropping it here
# would remove it from PATH. node stays pinned to what Omarchy installed.
node = "26.8.1"
claude = "latest"
gh = "latest"
uv = "latest"
# run-kit (`rk`) serves the tmux web console reached from the phone over
# Tailscale; `wt` is its worktree companion, needed only by `rk riff`.
# Neither is in the mise registry, so they resolve straight from GitHub
# releases (attestations + SLSA provenance are verified on install).
"github:sahil87/run-kit" = "latest"
"github:sahil87/wt" = "latest"
{{- end }}
