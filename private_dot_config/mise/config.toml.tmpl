[settings]
idiomatic_version_file_enable_tools = ["ruby"]
# Laya ships several releases a day and the older ones lack its CLIs, so the
# default 24h release-age cooldown would leave nothing installable.
# herdr moves fast and we want new releases as soon as they ship.
minimum_release_age_excludes = ["pipx:laya", "herdr"]

[settings.upgrade]
auto_prune = false

[tools]
go = "latest"
bun = "latest"
direnv = "latest"
azure-kubelogin = "0.2.14"
# Track the newest 3.10 patch rather than pinning one. Old patch releases
# stop building against current OpenSSL/toolchains, which is what broke the
# 3.10.12 install; mise resolves this to the highest available 3.10.x.
python = "3.10"
ruby = "3.3.5"
antigravity-cli = "latest"
# herdr is an agent-aware multiplexer -- it owns the terminal itself rather
# than layering on tmux, so it is an alternative to the tmux stack, not an
# addition to it. Resolved through the mise registry (aqua), which has
# macos-aarch64/x86_64 builds alongside the linux ones, so it is shared.
herdr = "latest"
# Claude Code CLI, unified across hosts via mise (aqua registry); the macOS
# desktop app still comes from the `claude` brew cask.
claude = "latest"
# pi coding agent (aqua registry, cross-platform builds).
pi = "latest"
# OpenAI Codex CLI (aqua registry, cross-platform builds).
codex = "latest"
# Laya: local System 1 decision engine (PyPI only). Installed through uv on
# both hosts; `serve` adds laya-serve, `mcp` adds laya-mcp-server.
"pipx:laya" = { version = "latest", extras = "serve,mcp", uvx_args = "--python 3.12" }
# GitHub CLI (aqua registry), shared across hosts instead of brew on macOS.
gh = "latest"
{{- if eq .chezmoi.os "darwin" }}
node = "latest"
{{- else }}
# Linux (Omarchy): these CLIs are provisioned through mise on this host.
# node stays pinned to what Omarchy installed.
node = "26.8.1"
uv = "latest"
# run-kit (`rk`) serves the tmux web console reached from the phone over
# Tailscale; `wt` is its worktree companion, needed only by `rk riff`.
# Neither is in the mise registry, so they resolve straight from GitHub
# releases (attestations + SLSA provenance are verified on install).
"github:sahil87/run-kit" = "latest"
"github:sahil87/wt" = "latest"
# muse: Meta's agent CLI, from their launcher script.
"http:muse" = { version = "latest", url = "https://api.meta.ai/muse-launcher.sh", bin = "muse", version_list_url = "https://api.meta.ai/muse-code/channels/muse-stable", version_json_path = ".version" }
# cursor-agent: Cursor's CLI agent, from Cursor's own download page.
cursor-agent = { version = "latest", bin_path = "bin", strip_components = "0", url = 'https://downloads.cursor.com/lab/{{ "{{" }} version {{ "}}" }}/{{ "{{" }} os(macos="darwin") {{ "}}" }}/{{ "{{" }} arch(arm64="arm64", x64="x64") {{ "}}" }}/agent-cli-package.tar.gz', version_date_expr = 'map(versions, { [#, replace(#[:10], ".", "-")] })', version_list_url = "https://cursor.com/install", version_regex = 'downloads\.cursor\.com/lab/([0-9]{4}\.[0-9]{2}\.[0-9]{2}-[0-9a-f]+)/', postinstall = 'mkdir -p "$MISE_TOOL_INSTALL_PATH/bin" && ln -sfn ../dist-package/cursor-agent "$MISE_TOOL_INSTALL_PATH/bin/cursor-agent"' }
# goose: Block's local agent CLI (aqua registry).
"aqua:aaif-goose/goose" = "1.59.2"
{{- end }}
