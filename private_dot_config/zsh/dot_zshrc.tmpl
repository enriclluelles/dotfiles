# Source aliases
[ -f "$ZDOTDIR/aliases" ] && source "$ZDOTDIR/aliases"

# vi key bindings (migrated from fish's fish_vi_key_bindings)
bindkey -v

# FZF integration
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

{{- if eq .chezmoi.os "darwin" }}
# Additional fzf key bindings (Homebrew installation)
if [ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]; then
    source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
fi

# FZF completion
if [ -f /opt/homebrew/opt/fzf/shell/completion.zsh ]; then
    source /opt/homebrew/opt/fzf/shell/completion.zsh
fi
{{- else }}
# fzf ships its shell integration under /usr/share on Arch/Debian.
for _fzf_f in /usr/share/fzf/key-bindings.zsh /usr/share/fzf/completion.zsh \
              /usr/share/doc/fzf/examples/key-bindings.zsh; do
    [ -f "$_fzf_f" ] && source "$_fzf_f"
done
unset _fzf_f
{{- end }}

# Initialize starship prompt
eval "$(starship init zsh)"

# Set up direnv if available
if command -v direnv &> /dev/null; then
    eval "$(direnv hook zsh)"
fi

# Set up mise if available
if command -v mise &> /dev/null; then
    eval "$(mise activate zsh)"
fi
