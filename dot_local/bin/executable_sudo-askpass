#!/usr/bin/env bash
# GUI-ish askpass for sudo: pops a floating terminal, reads password with gum, prints it to stdout.

# Callers started outside the desktop (herdr, SSH) have no display env, and ghostty
# then fails silently. Fall back to the running Hyprland session's socket.
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
if [[ -z $WAYLAND_DISPLAY ]]; then
  sock=$(ls "$runtime"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -1)
  [[ -n $sock ]] && export WAYLAND_DISPLAY=${sock##*/}
fi
if [[ -z $HYPRLAND_INSTANCE_SIGNATURE ]]; then
  sig=$(ls -t "$runtime/hypr" 2>/dev/null | head -1)
  [[ -n $sig ]] && export HYPRLAND_INSTANCE_SIGNATURE=$sig
fi
if [[ -z $WAYLAND_DISPLAY ]]; then
  echo "sudo-askpass: no Wayland session found in $runtime" >&2
  exit 1
fi

tmp=$(mktemp -u /tmp/askpass.XXXXXX)
mkfifo -m 600 "$tmp"
ghostty --class=dev.enric.sudo-askpass --title="sudo password" \
  -e bash -c "gum input --password --placeholder '${1:-sudo password:}' > '$tmp'" &
pass=$(timeout 120 cat "$tmp")
rm -f "$tmp"
printf '%s\n' "$pass"
